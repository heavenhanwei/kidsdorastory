{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duola-storybook",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "DUOLA_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "DUOLA_CLOUD_MODEL": "qwen3.8-flash"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2026101101",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "APP_RATE_LIMITER",
      "namespace_id": "2026101102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "dorastory.ifelse.work",
      "custom_domain": true
    }
  ]
}
